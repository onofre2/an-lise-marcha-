{
  "expo": {
    "name": "analise-marcha",
    "slug": "analise-marcha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC"
      },
      "package": "com.fisionofre.posturalglobal",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para realizar as avaliações posturais e de marcha."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "2f8dbc84-4db1-45dd-bb71-b48c72e12769"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2f8dbc84-4db1-45dd-bb71-b48c72e12769"
    }
  }
}
